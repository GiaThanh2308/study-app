# Copy this file to .env. Add keys only for the providers you choose to use.
# Keep backend/.env private; never put provider keys in the frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=1024
TAVILY_API_KEY=
STUDYAPP_DATA_DIR=./data
STUDYAPP_DB_PATH=./data/studyapp.sqlite3
